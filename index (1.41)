], pickedSpeciesKey: s, searchQuery: '' });\n    window.scrollTo({ top: 0, behavior: 'smooth' });\n  }\n\n  setSearch(e) { this.setState({ searchQuery: e.target.value }); }\n  clearSearch() { this.setState({ searchQuery: '' }); }\n\n  loadImageFor(sp) {\n    if (!sp) return;\n    this._imgCache = this._imgCache || {};\n    if (this._imgCache[sp.s]) { this.setState({ imgUrl: this._imgCache[sp.s], imgLoadingFor: null }); return; }\n    this.setState({ imgUrl: null, imgLoadingFor: sp.s });\n    const cleanWiki = (sp.wiki || '').replace(/×/g, '').replace(/\\s+/g, ' ').trim();\n    const cleanLatin = sp.s.replace(/×/g, '').replace(/\\s+/g, ' ').trim();\n    const zhName = sp.name.replace(/（[^）]*）|\\([^)]*\\)/g, '').trim();\n    const directTitles = [\n      { lang: 'en', title: cleanWiki },\n      { lang: 'zh', title: zhName },\n      { lang: 'en', title: cleanLatin },\n    ];\n    (async () => {\n      for (const t of directTitles) {\n        if (!t.title) continue;\n        try {\n          const r = await fetch(`https://${t.lang}.wikipedia.org/api/rest_v1/page/summary/${encodeURIComponent(t.title)}`);\n          if (!r.ok) continue;\n          const d = await r.json();\n          const src = (d.originalimage && d.originalimage.source) || (d.thumbnail && d.thumbnail.source);\n          if (src) {\n            this._imgCache[sp.s] = src;\n            if (this.state.imgLoadingFor === sp.s) this.setState({ imgUrl: src, imgLoadingFor: null });\n            return;\n          }\n        } catch (e) {}\n      }\n      const searches = [\n        { lang: 'en', q: cleanLatin || cleanWiki },\n        { lang: 'zh', q: zhName },\n      ];\n      for (const s of searches) {\n        if (!s.q) continue;\n        try {\n          const sr = await fetch(`https://${s.lang}.wikipedia.org/w/api.php?action=query&list=search&srsearch=${encodeURIComponent(s.q)}&format=json&srlimit=1&origin=*`);\n          if (!sr.ok) continue;\n          const sd = await sr.json();\n          const hit = sd.query && sd.query.search && sd.query.search[0];\n          if (!hit) continue;\n          const r2 = await fetch(`https://${s.lang}.wikipedia.org/api/rest_v1/page/summary/${encodeURIComponent(hit.title)}`);\n          if (!r2.ok) continue;\n          const d2 = await r2.json();\n          const src2 = (d2.originalimage && d2.originalimage.source) || (d2.thumbnail && d2.thumbnail.source);\n          if (src2) {\n            this._imgCache[sp.s] = src2;\n            if (this.state.imgLoadingFor === sp.s) this.setState({ imgUrl: src2, imgLoadingFor: null });\n            return;\n          }\n        } catch (e) {}\n      }\n      if (this.state.imgLoadingFor === sp.s) this.setState({ imgLoadingFor: null });\n    })();\n  }\n\n  renderVals() {\n    const SPECIES = this.state.speciesData;\n    if (!SPECIES) return { loaded: false, notLoaded: true };\n\n    const path = this.state.path;\n    const sp = this.getCurrentSpecies();\n    const showLatin = this.props.showLatinNames ?? true;\n\n    const crumbs = [{ label: '開始', sep: '', current: path.length === 0 && !sp, onClick: () => this.gotoLevel(0) }];\n    path.forEach((v, i) => {\n      crumbs.push({ label: `${LEVELS[i]}：${v}`, sep: '›', current: i === path.length - 1 && !sp, onClick: () => this.gotoLevel(i + 1) });\n    });\n    if (sp) crumbs.push({ label: `種：${sp.name}`, sep: '›', current: true, onClick: () => {} });\n\n    const q = this.state.searchQuery.trim().toLowerCase();\n    let searchHits = [];\n    if (q) {\n      const nq = this.normalizeStr(q);\n      const direct = SPECIES.filter(s =>\n        s.name.toLowerCase().includes(q) || this.normalizeStr(s.s).includes(nq) ||\n        this.normalizeStr(s.wiki).includes(nq) ||\n        s.g.includes(q) || s.f.includes(q) || s.o.includes(q) || s.c.includes(q)\n      );\n      let hits = direct;\n      if (hits.length === 0) {\n        hits = SPECIES.filter(s =>\n          this.fuzzySubsequence(nq, this.normalizeStr(s.s)) ||\n          this.fuzzySubsequence(q, s.name.toLowerCase()) ||\n          this.fuzzySubsequence(nq, this.normalizeStr(s.wiki))\n        );\n      }\n      searchHits = hits.slice(0, 12).map(s => ({\n        name: s.name, s: s.s, crumbTxt: `${s.k} › ${s.f}`, onClick: () => this.jump(s.s)\n      }));\n    }\n\n    let isList = true, isSpecies = false, options = [], stepName = '', levelLabel = '', spView = null;\n\n    if (sp) {\n      isList = false; isSpecies = true;\n      const taxRows = LEVELS.map((L, i) => ({ label: L, value: i === 6 ? `${sp.s}（${sp.name}）` : sp[KEYS[i]] }));\n      const backLv = path.length;\n      const iucn = this.classifyIUCN(sp);\n      const isFav = this.state.favoriteKeys.includes(sp.s);\n      spView = {\n        name: sp.name, s: sp.s, habit: sp.habit, habitat: sp.habitat, life: sp.life,\n        badges: [sp.k, sp.p, sp.c, sp.o, sp.f, sp.g],\n        iucnLabel: iucn.label, iucnColor: iucn.color,\n        isFavorite: isFav, favIcon: isFav ? '★ 已收藏' : '☆ 加入收藏',\n        toggleFavOnClick: () => this.toggleFavorite(sp.s),\n        taxRows,\n        imgUrl: this.state.imgUrl,\n        showPlaceholder: !this.state.imgUrl,\n        placeholderText: this.state.imgLoadingFor === sp.s ? '載入圖片中…' : sp.name,\n        backOnClick: () => this.gotoLevel(backLv),\n        deleteOnClick: () => this.deleteSpecies(sp),\n        editOnClick: () => this.startEdit(sp),\n        isEditing: this.state.editingKey === sp.s,\n        editName: this.state.editName, editHabit: this.state.editHabit,\n        editHabitat: this.state.editHabitat, editLife: this.state.editLife,\n        editK: this.state.editK, editP: this.state.editP, editC: this.state.editC,\n        editO: this.state.editO, editF: this.state.editF, editG: this.state.editG,\n        editPhotoPreview: this.state.editPhotoPreview,\n        setEditName: e => this.setField('editName', e.target.value),\n        setEditHabit: e => this.setField('editHabit', e.target.value),\n        setEditHabitat: e => this.setField('editHabitat', e.target.value),\n        setEditLife: e => this.setField('editLife', e.target.value),\n        setEditK: e => this.setField('editK', e.target.value),\n        setEditP: e => this.setField('editP', e.target.value),\n        setEditC: e => this.setField('editC', e.target.value),\n        setEditO: e => this.setField('editO', e.target.value),\n        setEditF: e => this.setField('editF', e.target.value),\n        setEditG: e => this.setField('editG', e.target.value),\n        handleEditPhotoUpload: e => this.handleEditPhotoUpload(e),\n        saveEditOnClick: () => this.saveEdit(sp),\n        cancelEditOnClick: () => this.cancelEdit(),\n      };\n    } else {\n      const lv = path.length;\n      const pool = SPECIES.filter(s => this.matches(s, lv, path));\n      stepName = STEP_NAMES[lv];\n      if (lv >= 6) {\n        levelLabel = '種';\n        options = pool.map(s => ({ name: s.name, latin: s.s, hasLatin: showLatin, hasCount: false, countLabel: '', onClick: () => this.pickSpecies(s.s) }));\n      } else {\n        levelLabel = LEVELS[lv];\n        const key = KEYS[lv];\n        const groups = {};\n        pool.forEach(s => { (groups[s[key]] = groups[s[key]] || []).push(s); });\n        options = Object.entries(groups).map(([val, arr]) => ({\n          name: val, hasLatin: false, latin: '', hasCount: true, countLabel: `${arr.length} 種生物`, onClick: () => this.pick(val)\n        }));\n      }\n    }\n\n    return {\n      loaded: true, notLoaded: false,\n      versionLabel: VERSION_LABEL, versionNotes: VERSION_NOTES,\n      versionOpen: this.state.versionOpen, toggleVersion: () => this.toggleVersion(),\n      addPanelOpen: this.state.addPanelOpen, addPanelLabel: this.state.addPanelOpen ? '－ 收起新增生物' : '＋ 新增生物',\n      toggleAddPanel: () => this.toggleAddPanel(),\n      newName: this.state.newName, setNewName: e => this.setField('newName', e.target.value),\n      newK: this.state.newK, setNewK: e => this.setField('newK', e.target.value),\n      newP: this.state.newP, setNewP: e => th