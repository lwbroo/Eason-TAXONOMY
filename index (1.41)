"color:var(--color-neutral-500);\">{{ c.sep }}<\u002Fspan>\n      <span sc-camel-on-click=\"{{ c.onClick }}\" style=\"cursor:pointer;color:var(--color-neutral-700);\" style-hover=\"color:var(--color-accent-700)\">{{ c.label }}<\u002Fspan>\n    <\u002Fsc-for>\n  <\u002Fdiv>\n\n  <sc-if value=\"{{ isList }}\" hint-placeholder-val=\"{{ true }}\">\n    <div>\n      <div style=\"font-size:.78rem;letter-spacing:.14em;text-transform:uppercase;color:var(--color-neutral-600);margin-bottom:6px;\">第 {{ stepName }} 步 / 共七步<\u002Fdiv>\n      <h2 style=\"font-family:var(--font-heading);font-size:1.6rem;font-weight:700;margin:0 0 24px;\">選擇「<span style=\"color:var(--color-accent-700)\">{{ levelLabel }}<\u002Fspan>」<\u002Fh2>\n      <div style=\"display:grid;grid-template-columns:repeat(auto-fill,minmax(210px,1fr));border-top:2px solid var(--color-divider);border-left:2px solid var(--color-divider);\">\n        <sc-for list=\"{{ options }}\" as=\"opt\" hint-placeholder-count=\"6\">\n          <div sc-camel-on-click=\"{{ opt.onClick }}\" style=\"padding:22px 20px;border-right:2px solid var(--color-divider);border-bottom:2px solid var(--color-divider);cursor:pointer;\" style-hover=\"background:var(--color-accent-100)\">\n            <div style=\"font-size:1.12rem;font-weight:700;\">{{ opt.name }}<\u002Fdiv>\n            <sc-if value=\"{{ opt.hasLatin }}\" hint-placeholder-val=\"{{ false }}\">\n              <div style=\"font-style:italic;color:var(--color-neutral-600);font-size:.82rem;margin-top:6px;\">{{ opt.latin }}<\u002Fdiv>\n            <\u002Fsc-if>\n            <sc-if value=\"{{ opt.hasCount }}\" hint-placeholder-val=\"{{ false }}\">\n              <div style=\"color:var(--color-accent-700);font-size:.8rem;margin-top:10px;font-weight:700;\">{{ opt.countLabel }}<\u002Fdiv>\n            <\u002Fsc-if>\n          <\u002Fdiv>\n        <\u002Fsc-for>\n      <\u002Fdiv>\n    <\u002Fdiv>\n  <\u002Fsc-if>\n\n  <sc-if value=\"{{ isSpecies }}\" hint-placeholder-val=\"{{ false }}\">\n    