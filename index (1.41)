ameMessage,\n      gameMessageColor: this.state.gameMessage && this.state.gameMessage.indexOf('✅') === 0 ? 'var(--color-text)' : 'var(--color-accent-700)',\n      gameProgressLabel: `${this.state.gameIndex + 1}/${this.state.gameTargets.length || 5}`,\n      gameElapsedLabel: this.formatTime(this.state.gameStatus === 'playing' && this.state.gameStartTime ? Date.now() - this.state.gameStartTime : 0),\n      gameTargetName: (this.state.gameTargets[this.state.gameIndex] || {}).name || '',\n      gameTargetLatin: (this.state.gameTargets[this.state.gameIndex] || {}).s || '',\n      gameTargetImg: this.state.gameTargetImgUrl,\n      gameFinalTimeLabel: this.formatTime(this.state.gameFinalTime || 0),\n      hasLeaderboard: (this.state.leaderboard || []).length > 0,\n      leaderboardRows: (this.state.leaderboard || []).slice(0, 10).map((row, i) => ({ rank: i + 1, name: row.name, timeLabel: this.formatTime(row.time) })),\n      pendingCount: this.state.pending.length,\n      hasPending: this.state.isOwner && this.state.pending.length > 0,\n      reviewOpen: this.state.reviewOpen, toggleReview: () => this.toggleReview(),\n      reviewLabel: this.state.reviewOpen ? '－ 收起待審核清單' : `📋 待審核清單（${this.state.pending.length}）`,\n      pendingList: this.state.pending.map(item => ({\n        name: item.name, s: item.s, k: item.k, habit: item.habit,\n        hasImg: !!item._img, img: item._img,\n        checkNote: item._check ? item._check.note : '（未執行自動核對）',\n        isVerified: !!(item._check && item._check.verified),\n        checkColor: (item._check && item._check.verified) ? 'var(--color-text)' : 'var(--color-accent-700)',\n        approveOnClick: () => this.approvePending(item),\n        rejectOnClick: () => this.rejectPending(item),\n      })),\n      crumbs, isList, isSpecies, options, stepName, levelLabel, sp: spView,\n      searchQuery: this.state.searchQuery, hasSearch: q.length > 0,\n      searchEnabled: this.state.gameStatus !== 'playing', searchDisabled: this.state.gameStatus === 'playing',\n      hasHits: searchHits.length > 0, noHits: q.length > 0 && searchHits.length === 0,\n      searchHits, totalCount: SPECIES.length,\n      setSearch: (e) => this.setSearch(e), clearSearch: () => this.clearSearch(),\n      showQuickLists: path.length === 0 && !sp && !q,\n      hasRecent: this.state.recentKeys.length > 0,\n      recentChips: this.state.recentKeys.map(k => {\n        const s = SPECIES.find(x => x.s === k);\n        return s ? { name: s.name, onClick: () => this.jump(s.s) } : null;\n      }).filter(Boolean),\n      hasFavorites: this.state.favoriteKeys.length > 0,\n      favoriteChips: this.state.favoriteKeys.map(k => {\n        const s = SPECIES.find(x => x.s === k);\n        return s ? { name: s.name, onClick: () => this.jump(s.s) } : null;\n      }).filter(Boolean),\n      gameMode: this.state.gameMode,\n      startDailyChallenge: () => this.startDailyChallenge(),\n      useHint: () => this.useHint(),\n      gameHintText: this.state.gameHintText,\n      hasHintText: !!this.state.gameHintText,\n      gameHintsUsed: this.state.gameHintsUsed,\n      hasDailyLeaderboard: (this.state.dailyLeaderboard || []).length > 0,\n      dailyLeaderboardRows: (this.state.dailyLeaderboard || []).slice(0, 10).map((row, i) => ({ rank: i + 1, name: row.name, timeLabel: this.formatTime(row.time) })),\n    };\n  }\n}\n<\u002Fscript>\n\n\n<\u002Fbody><\u002Fhtml>"
