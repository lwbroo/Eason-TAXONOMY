tle {\n  font-family: var(--font-heading); font-weight: var(--font-heading-weight);\n  font-size: 20px;\n}\n.dialog-body { font-size: 14px; opacity: 0.85; }\n.dialog-actions { display: flex; justify-content: flex-end; gap: var(--space-2); margin-top: var(--space-2); }\n\n<\u002Fstyle>\n<script src=\"96b2ddea-5125-4add-8c14-a5d92e79f2d9\"><\u002Fscript>\n<style>\nbody{margin:0;background:var(--color-bg);}\na{color:var(--color-accent-700);}\na:hover{color:var(--color-accent);}\n<\u002Fstyle>\n<\u002Fhelmet>\n\n<sc-if value=\"{{ loaded }}\" hint-placeholder-val=\"{{ false }}\">\n<sc-if value=\"{{ isOwner }}\" hint-placeholder-val=\"{{ false }}\">\n  <div style=\"position:fixed;top:50%;right:0;transform:translateY(-50%);z-index:40;\">\n    <button type=\"button\" sc-camel-on-click=\"{{ toggleGamePanel }}\" style=\"writing-mode:vertical-rl;background:var(--color-accent);color:#fff;border:2px solid var(--color-divider);border-right:none;padding:16px 10px;cursor:pointer;font-weight:700;letter-spacing:.05em;font-size:.85rem;\">🎮 遊戲模式<\u002Fbutton>\n  <\u002Fdiv>\n<\u002Fsc-if>\n<sc-if value=\"{{ gamePanelOpen }}\" hint-placeholder-val=\"{{ false }}\">\n  <div style=\"position:fixed;top:0;right:0;width:min(340px,92vw);height:100vh;background:var(--color-bg);border-left:2px solid var(--color-divider);box-shadow:var(--shadow-lg);z-index:41;overflow-y:auto;padding:24px;box-sizing:border-box;\">\n    <div style=\"display:flex;justify-content:space-between;align-items:center;margin-bottom:16px;\">\n      <h3 style=\"margin:0;font-family:var(--font-heading);font-size:1.15rem;\">🎮 生物探索競賽<\u002Fh3>\n      <button type=\"button\" class=\"btn btn-ghost\" sc-camel-on-click=\"{{ toggleGamePanel }}\">✕<\u002Fbutton>\n    <\u002Fdiv>\n    <sc-if value=\"{{ gameIdle }}\" hint-placeholder-val=\"{{ true }}\">\n      <p style=\"font-size:.82rem;color:var(--color-neutral-700);margin-bottom:16px;line-height:1.6;\">隨機出現 5 種生物的名字與照片，逐一在下方分類樹中探索找到牠們並按「確認找到」。開始計時後中途退出視為放棄，無法接關！<\u002Fp>\n      <button type=\"button\" class=\"btn btn-primary btn-block\" sc-camel-on-click=\"{{ startGame }}\">▶ 隨機遊戲開始<\u002Fbutton>\n      <button type=\"button\" class=\"btn btn-secondary btn-block\" style=\"margin-top:8px;\" sc-camel-on-click=\"{{ startDailyChallenge }}\">🗓 每日挑戰<\u002Fbutton>\n      <sc-if value=\"{{ hasLeaderboard }}\" hint-placeholder-val=\"{{ false }}\">\n        <h4 style=\"margin:24px 0 10px;font-size:.85rem;letter-spacing:.06em;text-transform:uppercase;color:var(--color-accent-700);\">🏆 一般模式排行（前十名）<\u002Fh4>\n        <sc-raw-table class=\"table\">\n          <sc-raw-tbody>\n            <sc-for list=\"{{ leaderboardRows }}\" as=\"row\" hint-placeholder-count=\"3\">\n              <sc-raw-tr><sc-raw-td style=\"width:24px;\">{{ row.rank }}<\u002Fsc-raw-td><sc-raw-td>{{ row.name }}<\u002Fsc-raw-td><sc-raw-td>{{ row.timeLabel }}<\u002Fsc-raw-td><\u002Fsc-raw-tr>\n            <\u002Fsc-for>\n          <\u002Fsc-raw-tbody>\n        <\u002Fsc-raw-table>\n      <\u002Fsc-if>\n      <sc-if value=\"{{ hasDailyLeaderboard }}\" hint-placeholder-val=\"{{ false }}\">\n        <h4 style=\"margin:20px 0 10px;font-size:.85rem;letter-spacing:.06em;text-transform:uppercase;color:var(--color-accent-700);\">🗓 今日挑戰排行（前十名）<\u002Fh4>\n        <sc-raw-table class=\"table\">\n          <sc-raw-tbody>\n            <sc-for list=\"{{ dailyLeaderboardRows }}\" as=\"row\" hint-placeholder-count=\"3\">\n              <sc-raw-tr><sc-raw-td style=\"width:24px;\">{{ row.rank }}<\u002Fsc-raw-td><sc-raw-td>{{ row.name }}<\u002Fsc-raw-td><sc-raw-td>{{ row.timeLabel }}<\u002Fsc-raw-td><\u002Fsc-raw-tr>\n            <\u002Fsc-for>\n          <\u002Fsc-raw-tbody>\n        <\u002Fsc-raw-table>\n      <\u002Fsc-if>\n    <\u002Fsc-if>\n    <sc-if value=\"{{ gamePlaying }}\" hint-placeholder-val=\"{{ false }}\">\n      <div style=\"border:2px solid var(--color-divider);padding:14px;margin-bottom:14px;\">\n        <div style=\"font-size:.7rem;color:var(--color-neutral-600);letter-spacing:.08em;text-transform:uppercase;\">第 {{ gameProgressLabel }} 個 · 計時 {{ gameElapsedLabel }}<\u002Fdiv>\n        <div style=\"font-weight:700;font-size:1.05rem;margin-top:6px;\">{{ gameTargetName }}<\u002Fdiv>\n        <div style=\"font-style:italic;color:var(--color-neutral-600);font-size:.8rem;\">{{ gameTargetLatin }}<\u002Fdiv>\n        <sc-if value=\"{{ gameTargetImg }}\" hint-placeholder-val=\"{{ false }}\">\n          <img src=\"{{ gameTargetImg }}\" style=\"width:100%;height:140px;object-fit:cover;margin-top:10px;border:2px solid var(--color-divider);\">\n        <\u002Fsc-if>\n      <\u002Fdiv>\n      <sc-if value=\"{{ gameMessage }}\" hint-placeholder-val=\"{{ false }}\">\n        <div style=\"font-size:.82rem;margin-bottom:10px;color:{{ gameMessageColor }};font-weight:700;\">{{ gameMessage }}<\u002Fdiv>\n      <\u002Fsc-if>\n      <sc-if value=\"{{ hasHintText }}\" hint-placeholder-val=\"{{ false }}\">\n        <div style=\"font-size:.8rem;background:var(--color-neutral-100);border:2px solid var(--color-divider);padding:8px 10px;margin-bottom:10px;\">{{ gameHintText }}<\u002Fdiv>\n      <\u002Fsc-if>\n      <div style=\"display:flex;gap:10px;flex-wrap:wrap;\">\n        <button type=\"button\" class=\"btn btn-primary\" sc-camel-on-click=\"{{ confirmFind }}\">✓ 確認找到<\u002Fbutton>\n        <button type=\"button\" class=\"btn btn-ghost\" sc-camel-on-click=\"{{ useHint }}\">💡 提示（+60秒）<\u002Fbutton>\n        <button type=\"button\" class=\"btn btn-ghost\" sc-camel-on-click=\"{{ quitGame }}\">✕ 退出<\u002Fbutton>\n      <\u002Fdiv>\n    <\u002Fsc-if>\n    <sc-if value=\"{{ gameFinished }}\" hint-placeholder-val=\"{{ false }}\">\n      <div>\n        <div style=\"font-size:1.2rem;font-weight:700;margin-bottom:6px;\">🎉 全部找到！<\u002Fdiv>\n        <div style=\"font-size:.85rem;color:var(--color-neutral-700);margin-bottom:16px;\">總花費時間：{{ gameFinalTimeLabel }}<\u002Fdiv>\n        <sc-if value=\"{{ gameMessage }}\" hint-placeholder-val=\"{{ false }}\">\n          <div style=\"font-size:.82rem;margin-bottom:10px;color:var(--color-accent-700);font-weight:700;\">{{ gameMessage }}<\u002Fdiv>\n        <\u002Fsc-if>\n        <input class=\"input\" style=\"width:100%;box-sizing:border-box;margin-bottom:10px;\" placeholder=\"輸入你的名字\" value=\"{{ gamePlayerName }}\" sc-camel-on-change=\"{{ setGamePlayerName }}\">\n        <button type=\"button\" class=\"btn btn-primary btn-block\" sc-camel-on-click=\"{{ submitScore }}\">加入排行榜<\u002Fbutton>\n      <\u002Fdiv>\n    <\u002Fsc-if>\n  <\u002Fdiv>\n<\u002Fsc-if>\n<div style=\"max-width:1120px;margin:0 auto;padding:clamp(24px,6vw,56px) clamp(14px,4vw,32px) 96px;font-family:var(--font-body);color:var(--color-text);\">\n\n  <div style=\"border-bottom:2px solid var(--color-divider);padding-bottom:28px;margin-bottom:36px;\">\n    <div style=\"font-size:11px;letter-spacing:.16em;text-transform:uppercase;color:var(--color-accent-700);font-weight:700;margin-bottom:10px;\">分類探索 / TAXONOMY<\u002Fdiv>\n    <div style=\"display:flex;align-items:baseline;gap:14px;flex-wrap:wrap;position:relative;\">\n      <h1 style=\"font-family:var(--font-heading);font-size:2.6rem;font-weight:700;letter-spacing:-.01em;margin:0;\">生物分類探索樹<\u002Fh1>\n      <span class=\"tag tag-outline\" sc-camel-on-click=\"{{ toggleVersion }}\" style=\"cursor:pointer;\">{{ versionLabel }}<\u002Fspan>\n      <span sc-camel-on-click=\"{{ ownerAction }}\" style=\"margin-left:auto;font-size:.72rem;color:var(--color-neutral-500);cursor:pointer;\">{{ ownerLabel }}<\u002Fspan>\n      <sc-if value=\"{{ versionOpen }}\" hint-placeholder-val=\"{{ false }}\">\n        <div style=\"position:absolute;top:100%;left:0;margin-top:8px;background:var(--color-bg);border:2px solid var(--color-divider);box-shadow:var(--shadow-md);padding:14px 16px;max-width:360px;z-index:10;\">\n          <div style=\"font-size:.7rem;letter-spacing:.1em;text-transform:uppercase;color:var(--color-accent-700);font-weight:700;margin-bottom:6px;\">{{ versionLabel }} 更新內容<\u002Fdiv>\n          <div style=\"font-size:.85rem;line-height:1.6;color:var(--color-text);\">{{ versionNotes }}<\u002Fdiv>\n        <\u002Fdiv>\n      <\u002Fsc-if>\n    <\u002Fdiv>\n    <p style=\"color:var(--color-neutral-700);margin-top:10px;font-size:1.02rem;max-width:56ch;\">從「界」開始，一步一步走到「種」，認識每一種生物。<\u002Fp>\n  <\u002Fdiv>\n\n  <sc-if value=\"{{ searchDisabled }}\" hint-placeholder-val=\"{{ false }}\">\n    <div style=\"border:2px solid var(--color-divider);padding:14px 18px;margin-bottom:8px;color:var(--color-neutral-600);font-size:.85rem;\">🎮 遊戲進行中，搜尋功能已停用。<\u002Fdiv>\n  <\u002Fsc-if>\n  <sc-if value=\"{{ showQuickLists }}\" hint-placeholder-val=\"{{ false }}\">\n    <sc-if value=\"{{ hasFavorites }}\" hint-placeholder-val=\"{{ false }}\">\n      <div style=\"margin-bottom:10px;\">\n        <div style=\"font-size:.75rem;letter-spacing:.08em;text-transform:uppercase;color:var(--color-neutral-600);margin-bottom:6px;\">★ 我的收藏<\u002Fdiv>\n        <div style=\"display:flex;flex-wrap:wrap;gap:8px;\">\n          <sc-for list=\"{{ favoriteChips }}\" as=\"chip\" hint-placeholder-count=\"3\">\n            <span class=\"tag tag-outline\" style=\"cursor:pointer;\" sc-camel-on-click=\"{{ chip.onClick }}\">{{ chip.name }}<\u002Fspan>\n          <\u002Fsc-for>\n        <\u002Fdiv>\n      <\u002Fdiv>\n    <\u002Fsc-if>\n    <sc-if value=\"{{ hasRecent }}\" hint-placeholder-val=\"{{ false }}\">\n      <div style=\"margin-bottom:20px;\">\n        <div style=\"font-size:.75rem;letter-spacing:.08em;text-transform:uppercase;color:var(--color-neutral-600);margin-bottom:6px;\">最近瀏覽<\u002Fdiv>\n        <div style=\"display:flex;flex-wrap:wrap;gap:8px;\">\n          <sc-for list=\"{{ recentChips }}\" as=\"chip\" hint-placeholder-count=\"3\">\n            <span class=\"tag tag-outline\" style=\"cursor:pointer;\" sc-camel-on-click=\"{{ chip.onClick }}\">{{ chip.name }}<\u002Fspan>\n          <\u002Fsc-for>\n        <\u002Fdiv>\n      <\u002Fdiv>\n    <\u002Fsc-if>\n  <\u002Fsc-if>\n  <sc-if value=\"{{ searchEnabled }}\" hint-placeholder-val=\"{{ true }}\">\n  <div style=\"display:flex;gap:0;margin-bottom:8px;border:2px solid var(--color-divider);\">\n    <input class=\"input\" style=\"flex:1;border:none;border-radius:0;\" placeholder=\"直接輸入生物名稱，例如：虎鯨、大貓熊、櫻花…\" value=\"{{ searchQuery }}\" sc-camel-on-change=\"{{ setSearch }}\">\n    <sc-if value=\"{{ hasSearch }}\" hint-placeholder-val=\"{{ false }}\">\n      <button type=\"button\" class=\"btn btn-ghost\" style=\"border-left:2px solid var(--color-divider);border-radius:0;\" sc-camel-on-click=\"{{ clearSearch }}\">清除<\u002Fbutton>\n    <\u002Fsc-if>\n  <\u002Fdiv>\n\n  <sc-if value=\"{{ hasSearch }}\" hint-placeholder-val=\"{{ false }}\">\n    <div style=\"border:2px solid var(--color-divider);border-top:none;margin-bottom:28px;\">\n      <sc-if value=\"{{ hasHits }}\" hint-placeholder-val=\"{{ true }}\">\n        <sc-for list=\"{{ searchHits }}\" as=\"hit\" hint-placeholder-count=\"3\">\n          <div sc-camel-on-click=\"{{ hit.onClick }}\" style=\"display:flex;justify-content:space-between;gap:16px;padding:14px 18px;border-bottom:2px solid var(--color-divider);cursor:pointer;\" style-hover=\"background:var(--color-accent-100)\">\n            <span><strong>{{ hit.name }}<\u002Fstrong>　<span style=\"font-style:italic;color:var(--color-neutral-600);font-size:.88rem;\">{{ hit.s }}<\u002Fspan><\u002Fspan>\n            <span style=\"color:var(--color-neutral-600);font-size:.88rem;\">{{ hit.crumbTxt }}<\u002Fspan>\n          <\u002Fdiv>\n        <\u002Fsc-for>\n      <\u002Fsc-if>\n      <sc-if value=\"{{ noHits }}\" hint-placeholder-val=\"{{ false }}\">\n        <div style=\"padding:16px 18px;color:var(--color-neutral-600);\">找不到「{{ searchQuery }}」— 資料庫目前收錄 {{ totalCount }} 種生物<\u002Fdiv>\n      <\u002Fsc-if>\n    <\u002Fdiv>\n  <\u002Fsc-if>\n  <\u002Fsc-if>\n\n  <div style=\"margin-bottom:24px;\">\n    <div style=\"display:flex;gap:10px;flex-wrap:wrap;\">\n      <button type=\"button\" class=\"btn btn-secondary\" sc-camel-on-click=\"{{ toggleAddPanel }}\">{{ addPanelLabel }}<\u002Fbutton>\n      <sc-if value=\"{{ hasPending }}\" hint-placeholder-val=\"{{ false }}\">\n        <button type=\"button\" class=\"btn btn-primary\" sc-camel-on-click=\"{{ toggleReview }}\">{{ reviewLabel }}<\u002Fbutton>\n      <\u002Fsc-if>\n    <\u002Fdiv>\n    <sc-if value=\"{{ submitMessage }}\" hint-placeholder-val=\"{{ false }}\">\n      <div style=\"margin-top:10px;font-size:.85rem;color:var(--color-accent-700);\">{{ submitMessage }}<\u002Fdiv>\n    <\u002Fsc-if>\n    <sc-if value=\"{{ reviewOpen }}\" hint-placeholder-val=\"{{ false }}\">\n      <div style=\"border:2px solid var(--color-divider);padding:20px;margin-top:12px;\">\n        <h3 style=\"margin:0 0 14px;font-family:var(--font-heading);font-size:1.1rem;\">待審核的新增生物<\u002Fh3>\n        <sc-for list=\"{{ pendingList }}\" as=\"item\" hint-placeholder-count=\"1\">\n          <div style=\"display:flex;gap:16px;padding:14px 0;border-bottom:2px solid var(--color-divider);align-items:center;\">\n            <sc-if value=\"{{ item.hasImg }}\" hint-placeholder-val=\"{{ false }}\">\n              <img src=\"{{ item.img }}\" style=\"width:64px;height:64px;object-fit:cover;border:2px solid var(--color-divider);\">\n            <\u002Fsc-if>\n            <div style=\"flex:1;\">\n              <div style=\"font-weight:700;\">{{ item.name }}　<span style=\"font-style:italic;color:var(--color-neutral-600);font-size:.85rem;\">{{ item.s }}<\u002Fspan><\u002Fdiv>\n              <div style=\"font-size:.8rem;color:var(--color-neutral-600);\">{{ item.k }} · {{ item.habit }}<\u002Fdiv>\n              <div style=\"font-size:.78rem;margin-top:4px;color:{{ item.checkColor }};font-weight:700;\">{{ item.checkNote }}<\u002Fdiv>\n            <\u002Fdiv>\n            <button type=\"button\" class=\"btn btn-primary\" sc-camel-on-click=\"{{ item.approveOnClick }}\">核准<\u002Fbutton>\n            <button type=\"button\" class=\"btn btn-ghost\" sc-camel-on-click=\"{{ item.rejectOnClick }}\">拒絕<\u002Fbutton>\n          <\u002Fdiv>\n        <\u002Fsc-for>\n      <\u002Fdiv>\n    <\u002Fsc-if>\n    <sc-if value=\"{{ addPanelOpen }}\" hint-placeholder-val=\"{{ false }}\">\n      <div style=\"border:2px solid var(--color-divider);padding:24px;margin-top:12px;\">\n        <h3 style=\"margin:0 0 16px;font-family:var(--font-heading);font-size:1.2rem;\">新增生物到資料庫<\u002Fh3>\n        <div style=\"display:grid;grid-template-columns:2fr 1fr;gap:10px;margin-bottom:12px;\">\n          <input class=\"input\" placeholder=\"中文或英文名稱，例如：熊貓、Panda\" value=\"{{ newName }}\" sc-camel-on-change=\"{{ setNewName }}\">\n          <button type=\"button\" class=\"btn btn-primary\" sc-camel-on-click=\"{{ autoLookup }}\">{{ lookupLabel }}<\u002Fbutton>\n        <\u002Fdiv>\n        <sc-if value=\"{{ lookupError }}\" hint-placeholder-val=\"{{ false }}\">\n          <div style=\"color:var(--color-accent-700);font-size:.85rem;margin-bottom:12px;\">{{ lookupError }}<\u002Fdiv>\n        <\u002Fsc-if>\n        <div style=\"display:grid;grid-template-columns:repeat(4,1fr);gap:10px;margin-bottom:10px;\">\n          <sc-raw-select class=\"input\" value=\"{{ newK }}\" sc-camel-on-change=\"{{ setNewK }}\">\n            <option value=\"動物界\">動物界<\u002Foption>\n            <option value=\"植物界\">植物界<\u002Foption>\n            <option value=\"真菌界\">真菌界<\u002Foption>\n          <\u002Fsc-raw-select>\n          <input class=\"input\" placeholder=\"門\" value=\"{{ newP }}\" sc-camel-on-change=\"{{ setNewP }}\">\n          <input class=\"input\" placeholder=\"綱\" value=\"{{ newC }}\" sc-camel-on-change=\"{{ setNewC }}\">\n          <input class=\"input\" placeholder=\"目\" value=\"{{ newO }}\" sc-camel-on-change=\"{{ setNewO }}\">\n          <input class=\"input\" placeholder=\"科\" value=\"{{ newF }}\" sc-camel-on-change=\"{{ setNewF }}\">\n          <input class=\"input\" placeholder=\"屬\" value=\"{{ newG }}\" sc-camel-on-change=\"{{ setNewG }}\">\n          <input class=\"input\" placeholder=\"學