ar\"},\n{k:\"動物界\",p:\"脊索動物門\",c:\"哺乳綱\",o:\"食肉目\",f:\"鼬科\",g:\"獾屬\",s:\"Taxidea taxus\",name:\"美洲獾\",habit:\"強壯的挖掘專家，前爪銳利善於快速挖洞追捕地下齧齒動物。\",habitat:\"北美的草原與開闊地。\",life:\"野外約 4–8 年。\",wiki:\"American badger\"},\n{k:\"動物界\",p:\"脊索動物門\",c:\"哺乳綱\",o:\"鱗甲目\",f:\"穿山甲科\",g:\"穿山甲屬\",s:\"Manis javanica\",name:\"馬來穿山甲\",habit:\"樹棲性較強的穿山甲，尾巴具抓握能力，因非法盜獵而數量銳減。\",habitat:\"東南亞的森林。\",life:\"野外約 20 年。\",wiki:\"Sunda pangolin\"},\n{k:\"動物界\",p:\"脊索動物門\",c:\"哺乳綱\",o:\"鱗甲目\",f:\"穿山甲科\",g:\"長尾穿山甲屬\",s:\"Manis tetradactyla\",name:\"長尾穿山甲\",habit:\"擁有相對比例最長尾巴的穿山甲，高度樹棲，白天多在樹洞中休息。\",habitat:\"西非與中非的雨林。\",life:\"野外約 15 年。\",wiki:\"Long-tailed pangolin\"},\n{k:\"動物界\",p:\"脊索動物門\",c:\"哺乳綱\",o:\"雙前齒目\",f:\"袋鼠科\",g:\"樹袋鼠屬\",s:\"Dendrolagus lumholtzi\",name:\"倫氏樹袋鼠\",habit:\"適應樹棲生活的袋鼠，四肢比例較地棲袋鼠短，善於在樹冠間跳躍移動。\",habitat:\"澳洲東北部的雨林。\",life:\"野外約 15 年。\",wiki:\"Lumholtz's tree-kangaroo\"},\n{k:\"動物界\",p:\"脊索動物門\",c:\"哺乳綱\",o:\"雙前齒目\",f:\"袋鼠科\",g:\"沙袋鼠屬\",s:\"Macropus giganteus\",name:\"東部灰大袋鼠\",habit:\"群居性強的大型袋鼠，善於長距離跳躍移動，雄性間會以拳擊方式競爭地位。\",habitat:\"澳洲東部的森林與草原。\",life:\"野外約 12–18 年。\",wiki:\"Eastern grey kangaroo\"},\n{k:\"動物界\",p:\"脊索動物門\",c:\"哺乳綱\",o:\"袋鼬目\",f:\"袋鼬科\",g:\"袋鼬屬\",s:\"Dasyurus maculatus\",name:\"斑點袋鼬\",habit:\"現存體型最大的肉食性有袋類之一，善於爬樹，毛皮布滿白色圓點斑紋。\",habitat:\"澳洲東部的森林。\",life:\"野外約 2–4 年。\",wiki:\"Spotted-tailed quoll\"},\n{k:\"動物界\",p:\"脊索動物門\",c:\"哺乳綱\",o:\"單孔目\",f:\"針鼴科\",g:\"原針鼴屬\",s:\"Zaglossus bruijnii\",name:\"西部長吻針鼴\",habit:\"體型較短吻針鼴大，喙部細長彎曲，主食蚯蚓，是極度瀕危的原始哺乳類。\",habitat:\"紐幾內亞的高山森林。\",life:\"野外估計約 30 年以上。\",wiki:\"Western long-beaked echidna\"},\n{k:\"動物界\",p:\"脊索動物門\",c:\"哺乳綱\",o:\"齧齒目\",f:\"豪豬科\",g:\"豪豬屬\",s:\"Hystrix brachyura\",name:\"馬來亞豪豬\",habit:\"體表布滿長硬棘刺用於防禦，遇威脅會抖動尾部棘刺發出警示聲響。\",habitat:\"東南亞的森林與農地。\",life:\"野外約 10–15 年。\",wiki:\"Malayan porcupine\"},\n{k:\"動物界\",p:\"脊索動物門\",c:\"哺乳綱\",o:\"齧齒目\",f:\"豪豬科\",g:\"豪豬屬\",s:\"Erethizon dorsatum\",name:\"北美豪豬\",habit:\"善於爬樹的齧齒動物，棘刺具倒鉤一旦刺入極難拔除，夜行性草食。\",habitat:\"北美的森林。\",life:\"野外約 10 年。\",wiki:\"North American porcupine\"},\n{k:\"動物界\",p:\"脊索動物門\",c:\"哺乳綱\",o:\"齧齒目\",f:\"刺豚鼠科\",g:\"刺豚鼠屬\",s:\"Dasyprocta punctata\",name:\"中美刺豚鼠\",habit:\"善於奔跑跳躍的齧齒動物，會將種子埋藏儲存，是熱帶雨林重要的種子傳播者。\",habitat:\"中南美洲的雨林。\",life:\"野外約 13 年。\",wiki:\"Central American agouti\"},\n{k:\"動物界\",p:\"脊索動物門\",c:\"哺乳綱\",o:\"齧齒目\",f:\"河狸鼠科\",g:\"河狸鼠屬\",s:\"Myocastor coypus\",name:\"河狸鼠（海狸鼠）\",habit:\"半水棲的大型齧齒動物，善游泳，因毛皮養殖逸出後在多地成為入侵種。\",habitat:\"南美原生，現廣泛入侵北美與歐洲水域。\",life:\"野外約 3–6 年。\",wiki:\"Coypu\"},\n{k:\"動物界\",p:\"脊索動物門\",c:\"哺乳綱\",o:\"兔形目\",f:\"鼠兔科\",g:\"鼠兔屬\",s:\"Ochotona curzoniae\",name:\"高原鼠兔\",habit:\"群居穴居的小型草食動物，是青藏高原生態系中重要的獵物與生態工程物種。\",habitat:\"青藏高原的高寒草甸。\",life:\"野外約 2–3 年。\",wiki:\"Plateau pika\"},\n{k:\"動物界\",p:\"脊索動物門\",c:\"鳥綱\",o:\"鴕形目\",f:\"美洲鴕鳥科\",g:\"美洲鴕屬\",s:\"Rhea pennata\",name:\"小美洲鴕\",habit:\"體型較大美洲鴕小，適應高海拔寒冷氣候，群居活動於安地斯高原。\",habitat:\"南美安地斯高原與巴塔哥尼亞。\",life:\"野外約 10 年。\",wiki:\"Lesser rhea\"},\n{k:\"動物界\",p:\"脊索動物門\",c:\"鳥綱\",o:\"雞形目\",f:\"雉科\",g:\"火雞屬\",s:\"Meleagris gallopavo\",name:\"野生火雞\",habit:\"北美原生的大型地棲鳥類，雄鳥求偶時會展開尾羽並發出響亮鳴叫。\",habitat:\"北美的森林與農地。\",life:\"野外約 3–5 年。\",wiki:\"Wild turkey\"},\n{k:\"動物界\",p:\"脊索動物門\",c:\"鳥綱\",o:\"雞形目\",f:\"雉科\",g:\"原雞屬\",s:\"Gallus gallus\",name:\"原雞\",habit:\"家雞的野生祖先種，群居於森林邊緣，雄鳥羽色鮮豔具長尾羽。\",habitat:\"南亞與東南亞的森林。\",life:\"野外約 5–8 年。\",wiki:\"Red junglefowl\"},\n{k:\"動物界\",p:\"脊索動物門\",c:\"鳥綱\",o:\"雁形目\",f:\"雁鴨科\",g:\"雁屬\",s:\"Anser cygnoides\",name:\"鴻雁（家鵝祖先）\",habit:\"家鵝的野生祖先種之一，喙基部具明顯瘤狀突起，群居性強長距離遷徙。\",habitat:\"東亞的濕地與草原。\",life:\"野外約 15–20 年。\",wiki:\"Swan goose\"},\n{k:\"動物界\",p:\"脊索動物門\",c:\"鳥綱\",o:\"雁形目\",f:\"雁鴨科\",g:\"天鵝屬\",s:\"Cygnus olor\",name:\"疣鼻天鵝\",habit:\"喙基部具明顯黑色疣狀突起，優雅的白色大型水禽，一夫一妻制終生相伴。\",habitat:\"歐亞大陸的湖泊與河流。\",life:\"野外約 20–30 年。\",wiki:\"Mute swan\"},\n{k:\"動物界\",p:\"脊索動物門\",c:\"鳥綱\",o:\"鷹形目\",f:\"鷹科\",g:\"角鵰屬\",s:\"Harpia harpyja\",name:\"角鵰\",habit:\"現存最強壯的猛禽之一，爪子力量驚人可捕獵樹懶與猴類等大型樹棲動物。\",habitat:\"中南美洲的熱帶雨林。\",life:\"野外約 25–35 年。\",wiki:\"Harpy eagle\"},\n{k:\"動物界\",p:\"脊索動物門\",c:\"鳥綱\",o:\"鴞形目\",f:\"鴟鴞科\",g:\"雕鴞屬\",s:\"Bubo blakistoni\",name:\"毛腿漁鴞\",habit:\"現存體型最大的貓頭鷹之一，善於捕魚，是東北亞極度瀕危的猛禽物種。\",habitat:\"東北亞的河岸原始林。\",life:\"野外約 20 年。\",wiki:\"Blakiston's fish owl\"},\n{k:\"動物界\",p:\"脊索動物門\",c:\"鳥綱\",o:\"雀形目\",f:\"天堂鳥科\",g:\"華美天堂鳥屬\",s:\"Lophorina superba\",name:\"華美天堂鳥\",habit:\"雄鳥求偶時會展開黑色斗篷狀羽毛與藍綠色胸甲，形成獨特的橢圓形展示。\",habitat:\"紐幾內亞的山地雨林。\",life:\"野外約 10 年。\",wiki:\"Superb bird-of-paradise\"},\n{k:\"動物界\",p:\"脊索動物門\",c:\"鳥綱\",o:\"鸚形目\",f:\"鳳頭鸚鵡科\",g:\"黑鳳頭鸚鵡屬\",s:\"Probosciger aterrimus\",name:\"棕櫚鳳頭鸚鵡\",habit:\"體型碩大的黑色鸚鵡，會用樹枝敲擊樹幹發出聲響作為求偶展示行為。\",habitat:\"紐幾內亞與澳洲北部的雨林。\",life:\"飼養可達 40–60 年。\",wiki:\"Palm cockatoo\"},\n{k:\"動物界\",p:\"脊索動物門\",c:\"鳥綱\",o:\"鸚形目\",f:\"鸚鵡科\",g:\"啄羊鸚鵡屬\",s:\"Nestor notabilis\",name:\"啄羊鸚鵡\",habit:\"高度好奇且智商極高的高山鸚鵡，會與同伴合作解決複雜的謎題與機關。\",habitat:\"紐西蘭南島的高山地帶。\",life:\"野外約 20 年。\",wiki:\"Kea\"},\n{k:\"動物界\",p:\"脊索動物門\",c:\"鳥綱\",o:\"鵜形目\",f:\"鷺科\",g:\"麻鷺屬\",s:\"Botaurus stellaris\",name:\"大麻鷺\",habit:\"遇威脅時會將頸部與喙向上伸直模擬蘆葦以隱蔽自身，叫聲低沉如牛吼。\",habitat:\"歐亞大陸的蘆葦濕地。\",life:\"野外約 10 年。\",wiki:\"Eurasian bittern\"},\n{k:\"動物界\",p:\"脊索動物門\",c:\"鳥綱\",o:\"雀形目\",f:\"太陽鳥科\",g:\"太陽鳥屬\",s:\"Aethopyga christinae\",name:\"叉尾太陽鳥\",habit:\"體型嬌小羽色鮮豔如寶石，長喙適合吸食花蜜，飛行敏捷似蜂鳥。\",habitat:\"中國南方與東南亞的森林。\",life:\"野外約 5 年。\",wiki:\"Fork-tailed sunbird\"},\n{k:\"動物界\",p:\"脊索動物門\",c:\"鳥綱\",o:\"雀形目\",f:\"太陽鳥科\",g:\"啄花鳥屬\",s:\"Dicaeum ignipectus\",name:\"紅胸啄花鳥\",habit:\"體型迷你的鳥類，主食桑寄生等植物的果實，對種子傳播扮演重要角色。\",habitat:\"南亞與東亞的山地森林。\",life:\"野外約 4 年。\",wiki:\"Fire-breasted flowerpecker\"},\n{k:\"動物界\",p:\"脊索動物門\",c:\"鳥綱\",o:\"雨燕目\",f:\"蜂鳥科\",g:\"蜂鳥屬\",s:\"Selasphorus rufus\",name:\"棕煌蜂鳥\",habit:\"遷徙距離相對體型極長的蜂鳥，具強烈領域性會積極驅趕入侵者。\",habitat:\"北美西部繁殖，冬季遷往墨西哥。\",life:\"野外約 3–5 年。\",wiki:\"Rufous hummingbird\"},\n{k:\"動物界\",p:\"脊索動物門\",c:\"鳥綱\",o:\"鴴形目\",f:\"蠣鷸科\",g:\"蠣鷸屬\",s:\"Haematopus ostralegus\",name:\"蠣鷸\",habit:\"嘴喙長而側扁呈鮮橙色，善於撬開貝殼與牡蠣取食內部軟體動物。\",habitat:\"歐亞大陸的沿海地區。\",life:\"野外約 30–40 年。\",wiki:\"Eurasian oystercatcher\"},\n{k:\"動物界\",p:\"脊索動物門\",c:\"鳥綱\",o:\"鴴形目\",f:\"鷸科\",g:\"半蹼鷸屬\",s:\"Limosa lapponica\",name:\"斑尾塍鷸\",habit:\"進行長距離不著陸遷徙飛行的候鳥之一，可連續飛