this.setState({\n      gameTargets: targets, gameIndex: 0, gameStatus: 'playing', gameStartTime: Date.now(),\n      gameMessage: '', path: [], pickedSpeciesKey: null, gamePlayerName: '', gameTargetImgUrl: null,\n      gameMode: 'daily', gameHintsUsed: 0, gameHintText: '',\n    });\n    this.loadGameTargetImage(targets[0]);\n    this._gameTimer = setInterval(() => this.forceUpdate(), 1000);\n  }\n\n  useHint() {\n    if (this.state.gameStatus !== 'playing') return;\n    const target = this.state.gameTargets[this.state.gameIndex];\n    if (!target) return;\n    this.setState(s => ({\n      gameStartTime: s.gameStartTime - 60000,\n      gameHintsUsed: s.gameHintsUsed + 1,\n      gameHintText: `提示：屬於「${target.c}」的「${target.o}」`,\n    }));\n  }\n\n  confirmFind() {\n    if (this.state.gameStatus !== 'playing') return;\n    const current = this.getCurrentSpecies();\n    const target = this.state.gameTargets[this.state.gameIndex];\n    if (current && target && current.s === target.s) {\n      const nextIndex = this.state.gameIndex + 1;\n      if (nextIndex >= this.state.gameTargets.length) {\n        this.finishGame();\n      } else {\n        this.setState({ gameIndex: nextIndex, path: [], pickedSpeciesKey: null, gameMessage: '✅ 正確！繼續尋找下一個。', gameHintText: '' });\n        this.loadGameTargetImage(this.state.gameTargets[nextIndex]);\n      }\n    } else {\n      this.setState({ gameMessage: '❌ 這不是目前要找的生物，請繼續探索。' });\n    }\n  }\n\n  finishGame() {\n    if (this._gameTimer) { clearInterval(this._gameTimer); this._gameTimer = null; }\n    const finalTime = Date.now() - this.state.gameStartTime;\n    this.setState({ gameStatus: 'finished', gameFinalTime: finalTime, path: [], pickedSpeciesKey: null, gameMessage: '' });\n  }\n\n  quitGame() {\n    if (!window.confirm('退出將視為放棄，不計入排行榜，且無法接關，確定要退出嗎？')) return;\n    if (this._gameTimer) { clearInterval(this._gameTimer); this._gameTimer = null; }\n    this.setState({ gameStatus: 'idle', gameTargets: [], gameIndex: 0, gameMessage: '', path: [], pickedSpeciesKey: null });\n  }\n\n  submitScore() {\n    const name = this.state.gamePlayerName.trim();\n    if (!name) { this.setState({ gameMessage: '請輸入名字才能加入排行榜。' }); return; }\n    const isDaily = this.state.gameMode === 'daily';\n    const storageKey = isDaily ? ('taxonomy-explorer-leaderboard-daily-' + this.todayKey()) : 'taxonomy-explorer-leaderboard';\n    const board = JSON.parse(localStorage.getItem(storageKey) || '[]');\n    board.push({ name, time: this.state.gameFinalTime, date: Date.now(), hints: this.state.gameHintsUsed });\n    board.sort((a, b) => a.time - b.time);\n    const top = board.slice(0, 20);\n    localStorage.setItem(storageKey, JSON.stringify(top));\n    this.setState(isDaily ? {\n      gameStatus: 'idle', gameTargets: [], gameIndex: 0, gamePlayerName: '', gameMessage: '', dailyLeaderboard: top,\n    } : {\n      gameStatus: 'idle', gameTargets: [], gameIndex: 0, gamePlayerName: '', gameMessage: '', leaderboard: top,\n    });\n  }\n\n  ownerAction() {\n    if (this.state.isOwner) {\n      if (window.confirm('要登出管理者模式嗎？')) {\n        localStorage.removeItem('taxonomy-explorer-owner');\n        this.setState({ isOwner: false });\n      }\n      return;\n    }\n    const input = window.prompt('請輸入管理者通關密語：');\n    if (input === OWNER_PASSCODE) {\n      localStorage.setItem('taxonomy-explorer-owner', '1');\n      this.setState({ isOwner: true });\n    } else if (input !== null) {\n      window.alert('密語錯誤。');\n    }\n  }\n\n  deleteSpecies(sp) {\n    if (!this.state.isOwner) return;\n    if (!window.confirm(`確定要刪除「${sp.name}」嗎？此操作無法復原。`)) return;\n    const deleted = JSON.parse(localStorage.getItem('taxonomy-explorer-deleted-species') || '[]');\n    if (!deleted.includes(sp.s)) deleted.push(sp.s);\n    localStorage.setItem('taxonomy-explorer-deleted-species', JSON.stringify(deleted));\n    const custom = JSON.parse(localStorage.getItem('taxonomy-explorer-custom-species') || '[]');\n    const updatedCustom = custom.filter(c => c.s